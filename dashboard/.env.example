# Copy to ".env" and fill in. Vite only exposes variables that start with VITE_.

# Browser MQTT must use secure WebSockets (wss). HiveMQ Cloud: port 8884, path /mqtt
VITE_MQTT_URL=wss://your-cluster.s1.eu.hivemq.cloud:8884/mqtt
VITE_MQTT_USERNAME=dashboard-admin
VITE_MQTT_PASSWORD=your-dashboard-password

# Must match MQTT_TOPIC and ROOM_ID in the ESP32's secrets.h
VITE_MQTT_TOPIC=smartroom/room-1
VITE_ROOM_ID=room-1

# How often the ESP32 sends status (ms). The dashboard flags the room as "no recent data" after 3 missed updates.
VITE_STATUS_INTERVAL_MS=5000

# ---- Only used by "npm run simulate" (a fake room for testing without hardware) ----
# Node connects over TLS directly (mqtts, port 8883)
SIM_MQTT_URL=mqtts://your-cluster.s1.eu.hivemq.cloud:8883
SIM_MQTT_USERNAME=esp32-room
SIM_MQTT_PASSWORD=your-device-password
